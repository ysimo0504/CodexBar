<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/header_region"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:importantForAccessibility="yes"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/time_block"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/current_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ink_black"
                android:textSize="46sp"
                android:textStyle="bold"
                tools:text="14:32" />

            <TextView
                android:id="@+id/current_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/ink_mid"
                android:textSize="14sp"
                tools:text="2026.07.28 TUE" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/device_summary"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/weather_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/weather_enable"
                android:focusable="true"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/weather_temperature_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="@string/weather_temperature_unknown"
                    android:textColor="@color/ink_black"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weather_detail_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="@string/weather_enable"
                    android:textColor="@color/ink_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/weather_attribution_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="@string/weather_attribution"
                    android:textColor="@color/ink_mid"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/refresh_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_button_ink"
                android:contentDescription="@string/refresh_now"
                android:padding="13dp"
                android:src="@drawable/ic_refresh_ink" />

            <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_button_ink"
                android:contentDescription="@string/open_settings"
                android:padding="13dp"
                android:src="@drawable/ic_settings_ink" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ink_light" />

    <LinearLayout
        android:id="@+id/usage_region"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/waiting_for_fixture"
            android:textAllCaps="true"
            android:textColor="@color/ink_mid"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.ysimo.codexbar.ink.ProviderPagerView
            android:id="@+id/provider_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/provider_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                tools:ignore="UselessParent" />
        </com.ysimo.codexbar.ink.ProviderPagerView>

        <LinearLayout
            android:id="@+id/provider_dots"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ink_light" />

    <LinearLayout
        android:id="@+id/focus_region"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/focus_summary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/focus_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/focus_timer"
                android:textAllCaps="true"
                android:textColor="@color/ink_mid"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/focus_minutes_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:textColor="@color/ink_black"
                android:textSize="52sp"
                android:textStyle="bold"
                tools:text="25:00" />

            <TextView
                android:id="@+id/focus_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="@string/remaining"
                android:textAllCaps="true"
                android:textColor="@color/ink_mid"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/focus_controls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/focus_play_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/button_ink"
                android:contentDescription="@string/start_focus"
                android:padding="15dp"
                android:src="@drawable/ic_play_ink"
                android:tint="@color/paper" />

            <ImageButton
                android:id="@+id/focus_pause_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_button_ink"
                android:contentDescription="@string/pause_focus"
                android:padding="15dp"
                android:src="@drawable/ic_pause_ink" />

            <ImageButton
                android:id="@+id/focus_reset_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_button_ink"
                android:contentDescription="@string/reset_focus"
                android:padding="15dp"
                android:src="@drawable/ic_reset_ink" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
