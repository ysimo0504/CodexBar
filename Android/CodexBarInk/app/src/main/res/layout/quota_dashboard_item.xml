<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ink_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quota_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:maxLines="2"
            android:textAllCaps="true"
            android:textColor="@color/ink_black"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="SESSION" />

        <TextView
            android:id="@+id/quota_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/ink_mid"
            android:textSize="14sp"
            tools:text="JUL 29 · 09:02" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/quota_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="72"
        android:progressDrawable="@drawable/progress_track_ink" />

    <TextView
        android:id="@+id/quota_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ink_black"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="72%" />
</LinearLayout>
