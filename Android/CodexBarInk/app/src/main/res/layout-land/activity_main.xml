<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="8dp"
    android:paddingEnd="28dp"
    android:paddingBottom="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/header_region"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="end|center_vertical"
        android:importantForAccessibility="yes"
        android:orientation="horizontal"
        android:screenReaderFocusable="true">

        <TextView
            android:id="@+id/dashboard_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/freshness_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/transport_status_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/refresh_now"
            android:padding="12dp"
            android:src="@drawable/ic_refresh_ink" />

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/open_settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings_ink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/codex_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="yes"
            android:orientation="vertical"
            android:paddingEnd="24dp"
            android:screenReaderFocusable="true">

            <TextView
                android:id="@+id/codex_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.08"
                android:text="@string/codex_provider"
                android:textAllCaps="true"
                android:textColor="@color/ink_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/codex_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:textColor="@color/codex_accent"
                android:textSize="46sp"
                android:textStyle="bold"
                tools:text="34% LEFT" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/codex_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/ink_black"
                    android:textSize="11sp"
                    tools:text="WEEKLY · 66% USED" />

                <TextView
                    android:id="@+id/codex_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/ink_mid"
                    android:textSize="11sp"
                    tools:text="JUL 29 · 09:02" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/codex_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_track_ink" />

            <TextView
                android:id="@+id/codex_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:maxLines="2"
                android:textColor="@color/ink_dark"
                android:textSize="13sp"
                tools:text="Codex Spark Weekly 98% left" />

            <TextView
                android:id="@+id/codex_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:textColor="@color/ink_black"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="正常运行 · PRO" />
        </LinearLayout>

        <View
            android:id="@+id/priority_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/ink_light" />

        <LinearLayout
            android:id="@+id/claude_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="yes"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:screenReaderFocusable="true">

            <TextView
                android:id="@+id/claude_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.08"
                android:text="@string/claude_provider"
                android:textAllCaps="true"
                android:textColor="@color/ink_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/claude_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:textColor="@color/claude_accent"
                android:textSize="46sp"
                android:textStyle="bold"
                tools:text="UNAVAILABLE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/claude_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/ink_black"
                    android:textSize="11sp"
                    tools:text="Temporarily unavailable" />

                <TextView
                    android:id="@+id/claude_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/ink_mid"
                    android:textSize="11sp"
                    tools:text="RESET —" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/claude_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_track_ink" />

            <TextView
                android:id="@+id/claude_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:maxLines="2"
                android:textColor="@color/ink_dark"
                android:textSize="13sp"
                tools:text="" />

            <TextView
                android:id="@+id/claude_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:textColor="@color/ink_black"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/generic_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:importantForAccessibility="yes"
        android:orientation="vertical"
        android:screenReaderFocusable="false">

        <LinearLayout
            android:id="@+id/generic_provider_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="UselessParent" />
    </LinearLayout>
</LinearLayout>
